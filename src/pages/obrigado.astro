---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";

const raw = Astro.url.searchParams.get("email")?.trim() ?? "";
const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(raw);
const subject = encodeURIComponent("Lista Lavi — correspondência");
const body = emailOk
  ? encodeURIComponent(`Olá Lavi,\n\nQuero entrar na lista quieta.\n\nEndereço: ${raw}\n`)
  : encodeURIComponent("Olá Lavi,\n\nQuero entrar na lista quieta.\n\nEndereço: \n");
const mailto = `mailto:${SITE.email}?subject=${subject}&body=${body}`;
---

<BaseLayout
  title="Correspondência"
  description="Pedido de correspondência recebido pela Lavi."
  robots="noindex,follow"
>
  <div class="wrap">
    <article class="prose">
      <p class="kicker">Lista</p>
      <h1 class="page-title">{emailOk ? "Pedido anotado" : "Quase lá"}</h1>
      {
        emailOk ? (
          <>
            <p>
              Recebemos o endereço <strong>{raw}</strong> neste pedido.
            </p>
            <p>
              Ainda não há provedor de lista ligado no site. Para confirmar o envio à redação, abra o e-mail abaixo — o endereço já vai no corpo. Sem sequência automática até ligarmos um provedor.
            </p>
          </>
        ) : (
          <p>
            Para entrar na lista quieta, use um e-mail válido no formulário da home ou do diário — ou escreva direto à redação.
          </p>
        )
      }
      <p>
        <a class="text-link" href={mailto}>Escrever para {SITE.email}</a>
      </p>
      <p class="muted">
        Aviso raro, só ensaio novo. Não vendemos listas. Detalhes em{" "}
        <a href="/etica">ética / privacidade</a>.
      </p>
      <p>
        <a class="text-link" href="/diario">Voltar ao diário</a>
        {" · "}
        <a class="text-link" href="/">Home</a>
      </p>
    </article>
  </div>
</BaseLayout>
