---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";
---

<BaseLayout
  title="Correspondência"
  description="Pedido de correspondência recebido pela Lavi."
  robots="noindex,follow"
>
  <div class="wrap">
    <article class="prose">
      <p class="kicker">Lista</p>
      <h1 class="page-title">Recebemos o endereço</h1>
      <p>
        Se quiser, envie o endereço direto a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <p class="muted">Até a lista estar ligada a um provedor, o aviso chega por e-mail editorial. Sem sequência automática.</p>
      <p><a class="text-link" href="/diario">Voltar ao diário</a></p>
    </article>
  </div>
</BaseLayout>
