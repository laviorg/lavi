---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";

const raw = Astro.url.searchParams.get("email")?.trim() ?? "";
const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(raw);
const subject = encodeURIComponent("Lista Lavi — correspondência");
const body = emailOk
  ? encodeURIComponent(`Olá Lavi,\n\nQuero entrar na lista quieta.\n\nEndereço: ${raw}\n`)
  : encodeURIComponent("Olá Lavi,\n\nQuero entrar na lista quieta.\n\nEndereço: \n");
const mailto = `mailto:${SITE.email}?subject=${subject}&body=${body}`;
---

<BaseLayout
  title="Correspondência"
  description="Pedido de correspondência recebido pela Lavi."
  robots="noindex,follow"
>
  <div class="wrap">
    <article class="prose">
      <p class="kicker">Lista</p>
      <h1 class="page-title">Recebemos o endereço</h1>
      {
        emailOk ? (
          <p>
            Anotamos <strong>{raw}</strong> neste pedido. Para confirmar o envio à redação (ainda sem provedor de lista), abra o e-mail abaixo — o endereço já vai no corpo.
          </p>
        ) : (
          <p>
            Para entrar na lista quieta, envie seu endereço à redação. Ainda não há captura automática.
          </p>
        )
      }
      <p>
        <a class="text-link" href={mailto}>Escrever para {SITE.email}</a>
      </p>
      <p class="muted">
        Sem sequência automática até ligarmos um provedor. Aviso raro, só ensaio novo.
      </p>
      <p><a class="text-link" href="/diario">Voltar ao diário</a></p>
    </article>
  </div>
</BaseLayout>
