---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { HUBS, CORPO_SOFT, CORPO_SOFT_IDS, EIXO_LABEL, essayPath, formatDate, countLabel, sortByDateDesc, essaysForCorpoSoft } from "../lib/site";

const hub = HUBS.corpo;
const allEssays = await getCollection("diario");
const essays = sortByDateDesc(allEssays.filter((e) => e.data.secao === "corpo"));
const softCounts = Object.fromEntries(
  CORPO_SOFT_IDS.map((id) => [id, essaysForCorpoSoft(id, allEssays).length]),
);
const axisCounts = Object.fromEntries(
  hub.axes.map((a) => [a.eixo, essays.filter((e) => e.data.eixo === a.eixo).length]),
);
---

<BaseLayout
  title="Corpo"
  description={hub.description}
  current="/corpo"
  ogImage={hub.ogImage}
>
  <div class="wrap">
    <div class="fade-in hub">
      <p class="kicker">{hub.kicker}</p>
      <h1 class="page-title">{hub.title}</h1>
      <p class="intro">{hub.intro}</p>
      <section class="hub-axes" aria-label="Caminhos de corpo soft">
        <p class="kicker">Caminhos</p>
        <ul class="axis-grid">
          {CORPO_SOFT_IDS.map((id) => (
            <li>
              <a class="axis-card" href={CORPO_SOFT[id].href}>
                <span class="axis-card__label">{CORPO_SOFT[id].label}</span>
                <span class="axis-card__blurb muted">{CORPO_SOFT[id].blurb}</span>
                <span class="axis-card__count">{countLabel(softCounts[id] ?? 0)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="hub-axes" aria-label="Eixos de Corpo">
        <p class="kicker">Neste hub</p>
        <ul class="axis-grid">
          {hub.axes.map((axis) => (
            <li>
              <a class="axis-card" href={`/eixo/${axis.eixo}`}>
                <span class="axis-card__label">{EIXO_LABEL[axis.eixo]}</span>
                <span class="axis-card__blurb muted">{axis.blurb}</span>
                <span class="axis-card__count">{countLabel(axisCounts[axis.eixo] ?? 0)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <div class="essay-list hub-list">
        {essays.map((entry) => (
          <a class="secao-row" href={essayPath(entry)}>
            <img src={entry.data.hero} alt={entry.data.heroAlt} width="720" height="480" loading="lazy" />
            <div>
              <p class="kicker">{EIXO_LABEL[entry.data.eixo]}</p>
              <time class="date" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <h2>{entry.data.title}</h2>
              <p class="muted">{entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
