---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  CORPO_SOFT,
  CORPO_SOFT_IDS,
  EIXO_LABEL,
  essayPath,
  formatDate,
  countLabel,
  essaysForCorpoSoft,
  SITE,
  type CorpoSoft,
} from "../../lib/site";
import { amazonSearch } from "../../lib/amazon";

export function getStaticPaths() {
  return CORPO_SOFT_IDS.map((hub) => ({ params: { hub } }));
}

const { hub } = Astro.params;
const key = hub as CorpoSoft;
const soft = CORPO_SOFT[key];
const all = await getCollection("diario");
const essays = essaysForCorpoSoft(key, all);
const ogEssay = all.find((e) => e.id === soft.ogEssay);
const ogImage = ogEssay?.data.ogImage ?? "/images/og-home.jpg";
const description = `${soft.label}: ${soft.blurb} Ensaios de corpo soft da Lavi — sem clínica.`;

const pecas: { title: string; query: string; reason: string; essayTitle: string; essayHref: string }[] = [];
const seen = new Set<string>();
for (const entry of essays) {
  for (const item of entry.data.selecao ?? []) {
    const k = item.query.toLowerCase();
    if (seen.has(k)) continue;
    seen.add(k);
    pecas.push({
      title: item.title,
      query: item.query,
      reason: item.reason,
      essayTitle: entry.data.title,
      essayHref: essayPath(entry),
    });
    if (pecas.length >= 6) break;
  }
  if (pecas.length >= 6) break;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${SITE.url}${soft.href}`,
      name: soft.label,
      description,
      url: `${SITE.url}${soft.href}`,
      inLanguage: SITE.locale,
      isPartOf: { "@id": `${SITE.url}/#website` },
    },
  ],
};
---

<BaseLayout
  title={`${soft.label} — Corpo`}
  description={description}
  current="/corpo"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <div class="fade-in hub">
      <p class="kicker">Corpo · Caminho</p>
      <h1 class="page-title">{soft.label}</h1>
      <p class="intro">{soft.intro}</p>
      <p class="muted">{countLabel(essays.length)}</p>

      <section class="hub-axes" aria-label="Eixos relacionados">
        <p class="kicker">Eixos</p>
        <ul class="axis-grid">
          {soft.eixos.map((eixo) => (
            <li>
              <a class="axis-card" href={`/eixo/${eixo}`}>
                <span class="axis-card__label">{EIXO_LABEL[eixo]}</span>
                <span class="axis-card__blurb muted">Neste eixo do diário</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="essay-list hub-list">
        {essays.map((entry) => (
          <a class="secao-row" href={essayPath(entry)}>
            <img src={entry.data.hero} alt={entry.data.heroAlt} width="720" height="480" loading="lazy" />
            <div>
              <p class="kicker">{EIXO_LABEL[entry.data.eixo]}</p>
              <time class="date" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <h2>{entry.data.title}</h2>
              <p class="muted">{entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      {
        pecas.length > 0 && (
          <aside class="selecao comodo-pecas" aria-labelledby="corpo-pecas-title">
            <p class="kicker">Neste caminho</p>
            <h2 id="corpo-pecas-title">Peças</h2>
            <ol>
              {pecas.map((item) => (
                <li>
                  <a href={amazonSearch(item.query)} rel="sponsored noopener noreferrer">
                    {item.title}
                  </a>
                  <p class="reason">{item.reason}</p>
                  <p class="fine" style="margin-top:0.35rem">
                    Em <a href={item.essayHref}>{item.essayTitle}</a>
                  </p>
                </li>
              ))}
            </ol>
            <p class="fine">
              Links afiliados quando indicados. <a href="/etica">Ética</a> · <a href="/selecao">Seleção</a>
            </p>
          </aside>
        )
      }

      <nav class="comodo-siblings" aria-label="Outros caminhos de corpo">
        <p class="kicker">Outros caminhos</p>
        <ul class="comodo-row">
          {CORPO_SOFT_IDS.filter((id) => id !== key).map((id) => (
            <li>
              <a class="comodo-chip" href={CORPO_SOFT[id].href}>
                <span class="comodo-chip__label">{CORPO_SOFT[id].label}</span>
                <span class="comodo-chip__blurb muted">{CORPO_SOFT[id].blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <p class="volume-more">
        <a class="text-link" href="/corpo">Voltar a Corpo</a>
      </p>
    </div>
  </div>
</BaseLayout>
