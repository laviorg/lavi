---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  COMODOS,
  COMODO_IDS,
  EIXO_LABEL,
  essayPath,
  formatDate,
  countLabel,
  essaysForComodo,
  pecasForComodo,
  SITE,
  type Comodo,
} from "../../lib/site";
import { amazonSearch } from "../../lib/amazon";

export function getStaticPaths() {
  return COMODO_IDS.map((comodo) => ({ params: { comodo } }));
}

const { comodo } = Astro.params;
const key = comodo as Comodo;
const hub = COMODOS[key];
const all = await getCollection("diario");
const essays = essaysForComodo(key, all);
const pecas = pecasForComodo(key, all, 6);
const ogEssay = all.find((e) => e.id === hub.ogEssay);
const ogImage = ogEssay?.data.ogImage ?? "/images/og-home.jpg";
const description = `${hub.label}: ${hub.blurb} Ensaios e peças da Lavi.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${SITE.url}${hub.href}`,
      name: hub.label,
      description,
      url: `${SITE.url}${hub.href}`,
      inLanguage: SITE.locale,
      isPartOf: { "@id": `${SITE.url}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Lavi", item: SITE.url },
        { "@type": "ListItem", position: 2, name: "Casa", item: `${SITE.url}/casa` },
        { "@type": "ListItem", position: 3, name: hub.label, item: `${SITE.url}${hub.href}` },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${hub.label} — Casa`}
  description={description}
  current="/casa"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <div class="fade-in hub">
      <p class="kicker">Casa · Cômodo</p>
      <h1 class="page-title">{hub.label}</h1>
      <p class="intro">{hub.intro}</p>
      <p class="muted">{countLabel(essays.length)}</p>

      <section class="hub-axes" aria-label="Eixos relacionados">
        <p class="kicker">Eixos</p>
        <ul class="axis-grid">
          {hub.eixos.map((eixo) => (
            <li>
              <a class="axis-card" href={`/eixo/${eixo}`}>
                <span class="axis-card__label">{EIXO_LABEL[eixo]}</span>
                <span class="axis-card__blurb muted">Neste eixo do diário</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="essay-list hub-list">
        {essays.map((entry) => (
          <a class="secao-row" href={essayPath(entry)}>
            <img src={entry.data.hero} alt={entry.data.heroAlt} width="720" height="480" loading="lazy" />
            <div>
              <p class="kicker">{EIXO_LABEL[entry.data.eixo]}</p>
              <time class="date" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <h2>{entry.data.title}</h2>
              <p class="muted">{entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      {
        pecas.length > 0 && (
          <aside class="selecao comodo-pecas" aria-labelledby="comodo-pecas-title">
            <p class="kicker">Neste cômodo</p>
            <h2 id="comodo-pecas-title">Peças</h2>
            <ol>
              {pecas.map((item) => (
                <li>
                  <a href={amazonSearch(item.query)} rel="sponsored noopener noreferrer">
                    {item.title}
                  </a>
                  <p class="reason">{item.reason}</p>
                  <p class="fine" style="margin-top:0.35rem">
                    Em <a href={item.essayHref}>{item.essayTitle}</a>
                  </p>
                </li>
              ))}
            </ol>
            <p class="fine">
              Links afiliados quando indicados. <a href="/etica">Ética</a> · <a href="/selecao">Seleção</a>
            </p>
          </aside>
        )
      }

      <nav class="comodo-siblings" aria-label="Outros cômodos">
        <p class="kicker">Outros cômodos</p>
        <ul class="comodo-row">
          {COMODO_IDS.filter((id) => id !== key).map((id) => (
            <li>
              <a class="comodo-chip" href={COMODOS[id].href}>
                <span class="comodo-chip__label">{COMODOS[id].label}</span>
                <span class="comodo-chip__blurb muted">{COMODOS[id].blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <p class="volume-more">
        <a class="text-link" href="/casa">Voltar a Casa</a>
      </p>
    </div>
  </div>
</BaseLayout>
