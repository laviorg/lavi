---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  SITE,
  SECAO_LABEL,
  COMODOS,
  COMODO_IDS,
  essayPath,
  formatDate,
  sortByDateDesc,
  countLabel,
} from "../../lib/site";

const all = sortByDateDesc(await getCollection("diario"));
const vol05Start = new Date("2027-05-01T00:00:00.000Z");
const vol06Start = new Date("2027-07-01T00:00:00.000Z");
const vol05 = all.filter(
  (e) => e.data.date.getTime() >= vol05Start.getTime() && e.data.date.getTime() < vol06Start.getTime(),
);
const hubs = [
  { href: "/casa", label: "Casa", desc: "Luz, tecido, superfície, cômodo." },
  { href: "/corpo", label: "Corpo", desc: "Banho, sono, movimento — soft, sem clínica." },
  { href: "/corpo/banho", label: "Banho", desc: "Temperatura, toalha, roupão." },
  { href: "/corpo/sono", label: "Sono e chão", desc: "Travesseiro, quarto, tapete." },
  { href: "/ritual", label: "Ritual", desc: "Gestos sem app: mesa, manhã, silêncio." },
  { href: "/selecao", label: "Seleção", desc: "Peças que atravessaram o texto." },
];

const description =
  "Vol. 05 — Maio–Junho: a casa no meio do ano, sem inverno de catálogo. Índice quiet living da Lavi.";
const ogImage = vol05[0]?.data.ogImage ?? "/images/vol-05-casa-no-meio-do-ano-og.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${SITE.url}/volume/05`,
      name: SITE.volume05,
      description,
      url: `${SITE.url}/volume/05`,
      inLanguage: SITE.locale,
      isPartOf: { "@id": `${SITE.url}/#website` },
    },
  ],
};
---

<BaseLayout
  title={SITE.volume05}
  description={description}
  current="/diario"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <article class="prose fade-in" style="max-width: 40rem;">
      <p class="kicker">Volume</p>
      <h1 class="page-title">{SITE.volume05}</h1>
      <p class="intro">
        Maio no feed pede inverno de catálogo. O Vol. 05 pede continuidade: a mesma casa, o calendário no meio, menos estímulo — sem flatlay de estação. Apartamento brasileiro. Critério quiet living. Calendário de oito semanas completo (4 mai–26 jun 2027).
      </p>
      <p>
        Abertura e fecha do volume no diário; o índice abaixo lista todos os ensaios. Arquivo de março–abril em{" "}
        <a href="/volume/04">{SITE.volume04}</a>.
      </p>
      <p class="muted">{countLabel(vol05.length)} neste volume (maio–junho 2027).</p>
    </article>

    <section class="hub-axes fade-in d1" aria-labelledby="vol05-ensaios" style="margin-top:2rem">
      <p class="kicker" id="vol05-ensaios">Neste volume</p>
      <div class="essay-list diary-grid" style="margin-top:1rem">
        {vol05.map((entry) => (
          <a class="diary-card" href={essayPath(entry)}>
            <img src={entry.data.hero} alt={entry.data.heroAlt} width="900" height="600" loading="lazy" />
            <div class="diary-card__body">
              <p class="kicker">{SECAO_LABEL[entry.data.secao]}</p>
              <h2>{entry.data.title}</h2>
              <p class="muted">{entry.data.description}</p>
              <time class="date" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            </div>
          </a>
        ))}
      </div>
      {vol05.length === 0 && <p class="muted">Os primeiros ensaios do volume entram em breve.</p>}
    </section>

    <hr class="rule" />

    <section aria-labelledby="vol05-comodos">
      <p class="kicker" id="vol05-comodos">Por cômodo</p>
      <nav class="comodo-row" aria-label="Cômodos">
        {COMODO_IDS.map((id) => (
          <a class="comodo-chip" href={COMODOS[id].href}>
            <span class="comodo-chip__label">{COMODOS[id].label}</span>
            <span class="comodo-chip__blurb muted">{COMODOS[id].blurb}</span>
          </a>
        ))}
      </nav>
    </section>

    <hr class="rule" />

    <section aria-labelledby="vol05-pilares">
      <p class="kicker" id="vol05-pilares">Pilares</p>
      <nav class="pillar-nav" aria-label="Pilares">
        {hubs.map((h) => (
          <a class="pillar-card" href={h.href}>
            <span class="pillar-card__label">{h.label}</span>
            <span class="pillar-card__desc muted">{h.desc}</span>
          </a>
        ))}
      </nav>
    </section>

    <p class="volume-more">
      <a class="text-link" href="/volume/04">{SITE.volume04} — arquivo</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href="/volume/03">{SITE.volume03}</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href="/diario">O diário completo</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href="/guia">Guia</a>
    </p>
  </div>
</BaseLayout>
