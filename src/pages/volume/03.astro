---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  SITE,
  SECAO_LABEL,
  COMODOS,
  COMODO_IDS,
  CORPO_SOFT,
  CORPO_SOFT_IDS,
  essayPath,
  formatDate,
  sortByDateDesc,
  countLabel,
} from "../../lib/site";

const all = sortByDateDesc(await getCollection("diario"));
const vol03Start = new Date("2027-01-01T00:00:00.000Z");
const vol03 = all.filter((e) => e.data.date.getTime() >= vol03Start.getTime());
const hubs = [
  { href: "/casa", label: "Casa", desc: "Luz, tecido, superfície, cômodo." },
  { href: "/corpo", label: "Corpo", desc: "Banho, sono, movimento — soft, sem clínica." },
  { href: "/corpo/banho", label: "Banho", desc: "Temperatura, prateleira, roupão." },
  { href: "/corpo/sono", label: "Sono e chão", desc: "Travesseiro, quarto, tapete." },
  { href: "/ritual", label: "Ritual", desc: "Gestos sem app: mesa, manhã, silêncio." },
  { href: "/selecao", label: "Seleção", desc: "Peças que atravessaram o texto." },
];

const description =
  "Vol. 03 — Janeiro–Fevereiro: a casa no começo do ano sem reset. Índice quiet living da Lavi.";
const ogImage = vol03[0]?.data.ogImage ?? "/images/vol-03-casa-no-comeco-do-ano-og.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${SITE.url}/volume/03`,
      name: SITE.volume03,
      description,
      url: `${SITE.url}/volume/03`,
      inLanguage: SITE.locale,
      isPartOf: { "@id": `${SITE.url}/#website` },
    },
  ],
};
---

<BaseLayout
  title={SITE.volume03}
  description={description}
  current="/diario"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <article class="prose fade-in" style="max-width: 40rem;">
      <p class="kicker">Volume</p>
      <h1 class="page-title">{SITE.volume03}</h1>
      <p class="intro">
        Janeiro no feed pede reset. O Vol. 03 pede continuidade: a mesma casa, os mesmos gestos, menos estímulo — sem lista de hábitos heroicos. Apartamento brasileiro. Critério quiet living. Sem vitrine. Sem pressa.
      </p>
      <p>
        Porta para o calendário de oito semanas (jan–fev 2027). Ensaios no ar abaixo; o arquivo de outubro–dezembro permanece em{" "}
        <a href="/volume/02">{SITE.volume02}</a>.
      </p>
      <p class="muted">{countLabel(vol03.length)} neste volume (a partir de janeiro 2027).</p>
    </article>

    <section class="hub-axes fade-in d1" aria-labelledby="vol03-ensaios" style="margin-top:2rem">
      <p class="kicker" id="vol03-ensaios">Neste volume</p>
      <div class="essay-list diary-grid" style="margin-top:1rem">
        {vol03.map((entry) => (
          <a class="diary-card" href={essayPath(entry)}>
            <img src={entry.data.hero} alt={entry.data.heroAlt} width="900" height="600" loading="lazy" />
            <div class="diary-card__body">
              <p class="kicker">{SECAO_LABEL[entry.data.secao]}</p>
              <h2>{entry.data.title}</h2>
              <p class="muted">{entry.data.description}</p>
              <time class="date" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            </div>
          </a>
        ))}
      </div>
      {vol03.length === 0 && <p class="muted">Os primeiros ensaios do volume entram em breve.</p>}
    </section>

    <hr class="rule" />

    <section aria-labelledby="vol03-comodos">
      <p class="kicker" id="vol03-comodos">Por cômodo</p>
      <nav class="comodo-row" aria-label="Cômodos">
        {COMODO_IDS.map((id) => (
          <a class="comodo-chip" href={COMODOS[id].href}>
            <span class="comodo-chip__label">{COMODOS[id].label}</span>
            <span class="comodo-chip__blurb muted">{COMODOS[id].blurb}</span>
          </a>
        ))}
      </nav>
    </section>

    <hr class="rule" />

    <section aria-labelledby="vol03-pilares">
      <p class="kicker" id="vol03-pilares">Pilares</p>
      <nav class="pillar-nav" aria-label="Pilares">
        {hubs.map((h) => (
          <a class="pillar-card" href={h.href}>
            <span class="pillar-card__label">{h.label}</span>
            <span class="pillar-card__desc muted">{h.desc}</span>
          </a>
        ))}
      </nav>
    </section>

    <p class="volume-more">
      <a class="text-link" href="/volume/02">{SITE.volume02} — arquivo</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href="/diario">O diário completo</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href="/guia">Guia</a>
    </p>
  </div>
</BaseLayout>
