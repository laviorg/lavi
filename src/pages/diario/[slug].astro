---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Newsletter from "../../components/Newsletter.astro";
import ShareStrip from "../../components/ShareStrip.astro";
import SelecaoBlock from "../../components/SelecaoBlock.astro";
import {
  SITE,
  SECAO_LABEL,
  EIXO_LABEL,
  essayPath,
  formatDate,
  readingMinutes,
  nextInSecao,
  relatedEssays,
  absoluteUrl,
} from "../../lib/site";

export async function getStaticPaths() {
  const essays = await getCollection("diario");
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, essays },
  }));
}

const { entry, essays } = Astro.props;
const { Content } = await render(entry);
const words = (entry.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const minutes = readingMinutes(words);
const next = nextInSecao(entry, essays);
const related = relatedEssays(entry, essays, next);
const url = absoluteUrl(essayPath(entry));
const secaoHref = `/${entry.data.secao}`;
const heroBase = entry.data.hero.replace(/\.jpg$/, "");
const srcset = `${heroBase}-800.jpg 800w, ${heroBase}-1200.jpg 1200w, ${entry.data.hero} 1600w`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${url}#article`,
      headline: entry.data.title,
      description: entry.data.description,
      image: {
        "@type": "ImageObject",
        url: absoluteUrl(entry.data.hero),
        width: 1600,
        height: 1066,
        caption: entry.data.heroAlt,
      },
      datePublished: entry.data.date.toISOString(),
      dateModified: entry.data.date.toISOString(),
      wordCount: words,
      inLanguage: SITE.locale,
      articleSection: SECAO_LABEL[entry.data.secao],
      isPartOf: { "@id": `${SITE.url}/#website` },
      author: { "@id": `${SITE.url}/#org` },
      publisher: { "@id": `${SITE.url}/#org` },
      mainEntityOfPage: { "@type": "WebPage", "@id": url },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Lavi", item: SITE.url },
        { "@type": "ListItem", position: 2, name: SECAO_LABEL[entry.data.secao], item: `${SITE.url}${secaoHref}` },
        { "@type": "ListItem", position: 3, name: entry.data.title, item: url },
      ],
    },
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  current="/diario"
  ogType="article"
  ogImage={entry.data.ogImage}
  ogImageAlt={entry.data.heroAlt}
  jsonLd={jsonLd}
  published={entry.data.date}
  modified={entry.data.date}
>
  <link slot="head" rel="preload" as="image" href={`${heroBase}-1200.jpg`} imagesrcset={srcset} imagesizes="(max-width: 720px) 100vw, (max-width: 1100px) 90vw, 1100px" />
  <div class="wrap">
    <div class="read-progress" id="read-progress" hidden></div>
    <article>
      <header class="essay-head prose fade-in">
        <p class="kicker">
          <a href={secaoHref}>{SECAO_LABEL[entry.data.secao]}</a>
          <span aria-hidden="true"> · </span>
          <span>{EIXO_LABEL[entry.data.eixo]}</span>
        </p>
        <h1>{entry.data.title}</h1>
        <p class="essay-meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min de leitura</span>
        </p>
      </header>
      <figure class="cover cover--wide fade-in d1">
        <img
          src={entry.data.hero}
          srcset={srcset}
          sizes="(max-width: 720px) 100vw, (max-width: 1100px) 90vw, 1100px"
          alt={entry.data.heroAlt}
          width="1600"
          height="1066"
          fetchpriority="high"
          decoding="async"
        />
        {entry.data.heroCaption && <figcaption>{entry.data.heroCaption}</figcaption>}
      </figure>
      <div class="prose essay-body fade-in d2">
        <Content />
        {entry.data.selecao && <SelecaoBlock items={entry.data.selecao} />}
        <ShareStrip url={url} title={entry.data.title} />
      </div>
    </article>
    {next && (
      <aside class="next-read fade-in" aria-label="Seguir lendo">
        <p class="kicker">Seguir lendo</p>
        <a class="next-read__card" href={essayPath(next)}>
          <span class="next-read__sec">{SECAO_LABEL[next.data.secao]}</span>
          <strong class="next-read__title">{next.data.title}</strong>
          <span class="next-read__desc muted">{next.data.description}</span>
        </a>
      </aside>
    )}
    <nav class="related" aria-label="Outros ensaios">
      <p class="kicker">No mesmo volume</p>
      <ul>
        {related.map((rel) => (
          <li>
            <p class="kicker">{SECAO_LABEL[rel.data.secao]}</p>
            <a href={essayPath(rel)}>{rel.data.title}</a>
          </li>
        ))}
      </ul>
    </nav>
    <hr class="rule" />
    <Newsletter />
    <script>
      (function () {
        var bar = document.getElementById("read-progress");
        var article = document.querySelector("article");
        if (!bar || !article) return;
        bar.removeAttribute("hidden");
        var onScroll = function () {
          var rect = article.getBoundingClientRect();
          var total = article.offsetHeight - window.innerHeight;
          var passed = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
          var pct = total > 0 ? (passed / total) * 100 : 0;
          bar.style.width = pct + "%";
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
      })();
    </script>
  </div>
</BaseLayout>
