---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página não encontrada"
  description="Essa página não está no arquivo da Lavi."
  robots="noindex,follow"
>
  <div class="wrap">
    <article class="prose">
      <p class="kicker">Arquivo</p>
      <h1 class="page-title">Não está aqui</h1>
      <p>Essa página saiu do mapa — ou nunca entrou. O diário continua no lugar.</p>
      <p><a class="text-link" href="/diario">Voltar ao diário</a></p>
    </article>
  </div>
</BaseLayout>
