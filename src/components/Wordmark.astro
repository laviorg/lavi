---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a href="/" class:list={["wordmark", className]} aria-label="Lavi, página inicial">
  <img
    src="/images/marca/logo-solido-220.png"
    srcset="/images/marca/logo-solido-220.png 220w, /images/marca/logo-solido-440.png 440w"
    sizes="(max-width: 720px) 110px, 140px"
    alt="Lavi"
    width="220"
    height="62"
    decoding="async"
  />
</a>
