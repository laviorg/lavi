---
import { amazonSearch } from "../lib/amazon";

interface Item {
  title: string;
  query: string;
  reason: string;
  essayTitle: string;
  essayHref: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="selecao-strip" aria-labelledby="selecao-strip-title">
      <div class="selecao-strip__head">
        <p class="kicker" id="selecao-strip-title">Seleção</p>
        <a class="text-link" href="/selecao">A lista completa</a>
      </div>
      <p class="selecao-strip__lead muted">
        Peças que atravessaram um ensaio. Critério editorial — não vitrine.
      </p>
      <ul class="selecao-strip__list">
        {items.map((item) => (
          <li>
            <a
              class="selecao-strip__title"
              href={amazonSearch(item.query)}
              rel="sponsored noopener noreferrer"
            >
              {item.title}
            </a>
            <p class="selecao-strip__reason muted">{item.reason}</p>
            <p class="selecao-strip__from">
              Em <a href={item.essayHref}>{item.essayTitle}</a>
            </p>
          </li>
        ))}
      </ul>
      <p class="fine">
        Alguns links são afiliados. A Lavi pode receber comissão, sem custo extra para você.{" "}
        <a href="/etica">Ética editorial</a>.
      </p>
    </section>
  )
}
